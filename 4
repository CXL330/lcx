#include <iostream>
 using namespace std;
 int main(){
     int L, M;
     bool tree[10001] = {false};
     cin >> L >> M;
     for(int i = 1; i <= M; i++){
         int l, r;
         cin >> l >> r;
         for(int pos = l; pos <= r; pos++){
             tree[pos] = true;
         }
     }
     int ans = 0;
     for(int i = 0; i <= L; i++){
         if(tree[i]==false) ans++;
     }
     cout << ans;
 }
