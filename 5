#include <iostream>
using namespace std;
int main() {
    int x, y;
    cin >> x >> y;
    if (x > y) {
        int temp = x;
        x = y;
        y = temp;
    }
    int count = 0;
    for (int i = x; i <= y; i++) {
        int temp = i;
        int sum = 0;
        while (temp > 0) {
            sum += temp % 10;
            temp /= 10;
        }
        if (sum % 5 == 0) {
            count++;
        }
    }
    cout << count << endl;
}
