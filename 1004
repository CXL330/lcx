#include<iostream>
#include<string>
using namespace std;
pair<string,char> dict[] = {
    {"zero",'0'},
    {"four",'4'},
    {"nine",'9'},
    {"two",'2'},
    {"six",'6'},
};
int main(){
    ios::sync_with_stdio(false);
    
    cin.tie(nullptr);
    int T;
    cin >> T;
    while(T--){
        string s ,ans;
        cin >> s;
        int i = 0;
        int n = s.size();
        while(i < n){
            if(s[i] == '0' || s[i] == '2' || s[i] == '4' || s[i] == '6' || s[i] == '9'){
                ans += s[i];
                i++;
                continue;
            }
            bool ok = false;
            for(auto &p : dict){
                int len = p.first.size();
                if(i + len <= n && s.substr(i, len) == p.first){
                    ans += p.second;
                    i += len;
                    ok = true;
                    break;
                }
            }
            if(!ok) i++;
        }
        cout << ans << '\n';
    }
}
