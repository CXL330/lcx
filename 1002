#include<stdio.h>
int main(void){
    int n, x;
    scanf("%d%d",&n,&x);
    long long count = 0;
    for(int i = 1; i <= n;i++){
        int y = i;
        while(y > 0){
            if(y % 10 == x){
                count++;
            }
            y = y / 10;
        }
    }
    printf("%lld\n",count);
}
