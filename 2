B卡拉兹函数
#include<bits/stdc++.h>
using namespace std;
int f(int n){
    if(n % 2 == 0)return n / 2;
    else return 3 * n + 1;
}
int main(){
    int n;
    cin >> n;
    cout << f(n);
}
