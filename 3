#include<stdio.h>
int main(){
    int n;
    int i,j;
    int num = 1;
    scanf("%d",&n);
    for(i = 1; i <= n; i++){
        for(j =1;j <= i; j++){
            printf("%4d",num);
            num = num + 1;
        }
        printf("\n");
    }
}
