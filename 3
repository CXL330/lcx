#include<bits/stdc++.h>
using namespace std;
int main(){
    int t;
    cin >> t;
    while (t--){
        int n;
        cin >> n;
        for (int i = 1; i <= (n-1) / 2; i++){
            for(int j = 1;j <= (n - 1) / 2 - i + 1; j++){
                cout << ' ';
            }
            for(int j =1; j <= 2 * i - 1; j++){
                cout << '*';
            }
            cout << '\n';
        }
        for(int i = 1; i <= n; i++){
            cout << '*';
        }
        cout << '\n';
        for(int i = 1; i <= (n - 1) / 2; i++){
            for(int j =1; j <= i; j++){
                cout << ' ';
            }
            for(int j = 1;j <=n - 2 * i;j++){
                cout << '*';
            }
            cout << '\n';
        }
    }
}
