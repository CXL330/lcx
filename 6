#include <iostream>
#include <algorithm>
using namespace std;
const int MAXN = 100001;
int A[MAXN];
int B[MAXN];
int diff[MAXN];
int main(){
    int n, K;
    cin >> n >> K;
    for(int i = 0; i < n; i++){
        cin >> A[i];
    }
    for(int i = 0; i < n; i++){
        cin >> B[i];
    }
    long long sum = 0;
    for(int i = 0; i < n; i++){
        sum = sum + B[i];
        diff[i] = A[i] - B[i];
    }
    sort(diff, diff + n, greater<int>());
    for(int i = 0; i < K; i++){
        sum = sum + diff[i];
    }
 
    cout << sum << endl;
}
