#include<iostream>
#include<string>
using namespace std;
int main(){
    string s;
    cin >> s;
    int cnta = 0, cntb = 0;
    bool ok = true;
    for(int i = 0; i < s.size(); i++){
        if(s[i] =='a'){
            cnta++;
        }
        else if(s[i] == 'b'){
            cntb++;
        }
        else{
            ok = false;
            break;
        }
        if(cntb > cnta){
            ok = false;
            break;
        }
    }
    if(ok && cnta == cntb){
        cout << "Good" << endl;
    }
    else{
        cout << "Bad" << endl;
    }
}
